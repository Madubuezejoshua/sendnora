// InvoiceTap database schema.
//
// Design notes (see DATABASE.md for the full rationale):
// - Every tenant-owned row carries a `workspaceId` column with an index, and
//   every query in apps/api MUST filter by the workspaceId derived from the
//   authenticated session — never from an untrusted client field alone.
// - Money is stored as an `Int` count of minor units (cents/kobo/etc). This
//   comfortably covers this product's target market (freelancers and SMEs,
//   up to ~21.4M major units in a 2-decimal currency) without the
//   application-wide BigInt-serialization overhead that a bigger ceiling
//   would require. See packages/shared/src/money for the arithmetic layer.
// - Quantities, tax rates and discount percentages use `Decimal` for
//   arbitrary-precision math (fractional hours, precise tax rates).
// - Quote/Invoice line items snapshot their description/price/tax at
//   creation time instead of living FKs, so editing a Product later never
//   changes an already-issued document. Receipts additionally snapshot the
//   full document as JSON for legal immutability.
// - Public-facing document links use a separate random `publicToken`
//   column, never the internal cuid, so links can be revoked/rotated
//   independently and never leak sequential IDs.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================================
// AUTH (Auth.js-compatible: User/Account/Session/VerificationToken shapes)
// ============================================================================

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  isPlatformAdmin Boolean       @default(false)
  platformRole    PlatformRole?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  accounts          Account[]
  sessions          Session[]
  workspaceMembers  WorkspaceMember[]
  ownedWorkspaces   Workspace[]           @relation("WorkspaceOwner")
  twoFactorSecret   TwoFactorSecret?
  recoveryCodes     RecoveryCode[]
  loginEvents       LoginEvent[]
  passwordResets    PasswordResetToken[]
  notifications     Notification[]
  sentInvitations   WorkspaceInvitation[] @relation("InvitedBy")
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  apiKeys           ApiKey[]
  pushSubscriptions PushSubscription[]

  @@index([email])
}

enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactorSecret {
  id              String    @id @default(cuid())
  userId          String    @unique
  secretEncrypted String
  enabled         Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================================================
// WORKSPACES / MULTI-TENANCY / RBAC
// ============================================================================

model Workspace {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  ownerId String

  businessType    BusinessType @default(FREELANCER)
  countryCode     String
  timezone        String       @default("UTC")
  locale          String       @default("en")
  defaultCurrency String

  invoiceDueDays   Int     @default(14)
  defaultNotes     String? @db.Text
  defaultTerms     String? @db.Text
  brandColor       String?
  pdfTemplateKey   String  @default("MODERN")
  numberingFormats Json?

  onboardingCompletedAt DateTime?
  onboardingStep        String?

  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner                  User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members                WorkspaceMember[]
  invitations            WorkspaceInvitation[]
  businessProfile        BusinessProfile?
  customers              Customer[]
  products               Product[]
  categories             Category[]
  taxRates               TaxRate[]
  discounts              Discount[]
  documentSequences      DocumentSequence[]
  quotes                 Quote[]
  invoices               Invoice[]
  receipts               Receipt[]
  payments               Payment[]
  paymentAttempts        PaymentAttempt[]
  refunds                Refund[]
  creditNotes            CreditNote[]
  expenses               Expense[]
  recurringInvoices      RecurringInvoice[]
  reminderSchedules      ReminderSchedule[]
  messageDeliveries      MessageDelivery[]
  fileAssets             FileAsset[]
  documentTemplates      DocumentTemplate[]
  subscription           Subscription?
  usageCounters          UsageCounter[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  supportTickets         SupportTicket[]
  apiKeys                ApiKey[]
  webhookEvents          WebhookEvent[]
  paymentProviderConfigs PaymentProviderConfig[]

  @@index([ownerId])
}

enum BusinessType {
  FREELANCER
  SOLE_PROPRIETOR
  PARTNERSHIP
  LIMITED_COMPANY
  NGO
  OTHER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  invitedAt   DateTime      @default(now())
  joinedAt    DateTime?
  removedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  WORKSPACE_OWNER
  WORKSPACE_ADMIN
  ACCOUNTANT
  STAFF
  VIEWER
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model BusinessProfile {
  id              String  @id @default(cuid())
  workspaceId     String  @unique
  legalName       String?
  displayName     String
  contactEmail    String?
  contactPhone    String?
  website         String?
  taxIdNumber     String?
  logoFileAssetId String?
  addressId       String? @unique

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  address   Address?   @relation(fields: [addressId], references: [id])
  logo      FileAsset? @relation(fields: [logoFileAssetId], references: [id])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Address {
  id          String  @id @default(cuid())
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  countryCode String

  businessProfile  BusinessProfile?
  customerBilling  Customer[]       @relation("CustomerBillingAddress")
  customerShipping Customer[]       @relation("CustomerShippingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// CUSTOMERS
// ============================================================================

model Customer {
  id                String       @id @default(cuid())
  workspaceId       String
  type              CustomerType @default(INDIVIDUAL)
  name              String
  email             String?
  phone             String?
  whatsappPhone     String?
  // Telegram bots can't message first: the customer opens t.me/<bot>?start=<telegramLinkToken>, which fills telegramChatId.
  telegramChatId    String?
  telegramLinkToken String?      @unique
  taxIdNumber       String?
  currency          String?
  notes             String?      @db.Text

  billingAddressId  String?
  shippingAddressId String?

  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingAddress  Address?  @relation("CustomerBillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress Address?  @relation("CustomerShippingAddress", fields: [shippingAddressId], references: [id])

  quotes            Quote[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]

  @@index([workspaceId, status])
  @@index([workspaceId, email])
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

// ============================================================================
// PRODUCTS / SERVICES / TAX / DISCOUNTS
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([workspaceId, name])
}

model TaxRate {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  ratePercent Decimal   @db.Decimal(6, 3)
  isDefault   Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([workspaceId])
}

model Discount {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  type        DiscountType
  value       Decimal      @db.Decimal(12, 3)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Product {
  id                  String        @id @default(cuid())
  workspaceId         String
  kind                ProductKind   @default(SERVICE)
  name                String
  description         String?       @db.Text
  sku                 String?
  unit                String        @default("unit")
  unitPriceMinorUnits Int
  currency            String
  taxRateId           String?
  categoryId          String?
  status              ProductStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  archivedAt          DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taxRate   TaxRate?  @relation(fields: [taxRateId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])

  quoteItems            QuoteItem[]
  invoiceItems          InvoiceItem[]
  recurringInvoiceItems RecurringInvoiceItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, sku])
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

// ============================================================================
// DOCUMENT NUMBERING
// ============================================================================

model DocumentSequence {
  id           String       @id @default(cuid())
  workspaceId  String
  documentType DocumentType
  year         Int
  currentValue Int          @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, documentType, year])
}

enum DocumentType {
  QUOTE
  INVOICE
  RECEIPT
  CREDIT_NOTE
}

enum TaxMode {
  EXCLUSIVE
  INCLUSIVE
}

// ============================================================================
// QUOTES
// ============================================================================

model Quote {
  id          String      @id @default(cuid())
  workspaceId String
  customerId  String
  number      String
  publicToken String      @unique
  status      QuoteStatus @default(DRAFT)

  currency   String
  taxMode    TaxMode   @default(EXCLUSIVE)
  issueDate  DateTime
  expiryDate DateTime?

  documentDiscountType     DiscountType?
  documentDiscountValue    Decimal?      @db.Decimal(12, 3)
  shippingMinorUnits       Int           @default(0)
  additionalFeesMinorUnits Int           @default(0)

  subtotalMinorUnits      Int
  totalDiscountMinorUnits Int @default(0)
  totalTaxMinorUnits      Int
  grandTotalMinorUnits    Int

  notes         String? @db.Text
  terms         String? @db.Text
  internalNotes String? @db.Text

  sentAt             DateTime?
  viewedAt           DateTime?
  respondedAt        DateTime?
  rejectionReason    String?   @db.Text
  convertedInvoiceId String?   @unique
  cancelledAt        DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id])
  items             QuoteItem[]
  convertedInvoice  Invoice?          @relation("QuoteConversion", fields: [convertedInvoiceId], references: [id])
  messageDeliveries MessageDelivery[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([customerId])
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

model QuoteItem {
  id                  String        @id @default(cuid())
  quoteId             String
  productId           String?
  position            Int           @default(0)
  description         String
  quantity            Decimal       @db.Decimal(14, 4)
  unitPriceMinorUnits Int
  taxRatePercent      Decimal       @default(0) @db.Decimal(6, 3)
  discountType        DiscountType?
  discountValue       Decimal?      @db.Decimal(12, 3)

  taxableBaseMinorUnits Int
  taxAmountMinorUnits   Int
  lineTotalMinorUnits   Int

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

// ============================================================================
// INVOICES
// ============================================================================

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  customerId  String
  number      String
  publicToken String        @unique
  status      InvoiceStatus @default(DRAFT)

  currency  String
  taxMode   TaxMode  @default(EXCLUSIVE)
  issueDate DateTime
  dueDate   DateTime

  documentDiscountType      DiscountType?
  documentDiscountValue     Decimal?      @db.Decimal(12, 3)
  shippingMinorUnits        Int           @default(0)
  additionalFeesMinorUnits  Int           @default(0)
  depositRequiredMinorUnits Int?

  subtotalMinorUnits      Int
  totalDiscountMinorUnits Int @default(0)
  totalTaxMinorUnits      Int
  grandTotalMinorUnits    Int
  amountPaidMinorUnits    Int @default(0)

  notes               String? @db.Text
  terms               String? @db.Text
  paymentInstructions String? @db.Text

  sourceQuoteId String?

  issuedAt    DateTime?
  sentAt      DateTime?
  viewedAt    DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  voidReason  String?   @db.Text
  cancelledAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  sourceQuote Quote?        @relation("QuoteConversion")

  receipts           Receipt[]
  paymentAllocations PaymentAllocation[]
  paymentAttempts    PaymentAttempt[]
  creditNotes        CreditNote[]
  reminderSchedules  ReminderSchedule[]
  messageDeliveries  MessageDelivery[]
  fileAssets         FileAsset[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([customerId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

model InvoiceItem {
  id                  String        @id @default(cuid())
  invoiceId           String
  productId           String?
  position            Int           @default(0)
  description         String
  quantity            Decimal       @db.Decimal(14, 4)
  unitPriceMinorUnits Int
  taxRatePercent      Decimal       @default(0) @db.Decimal(6, 3)
  discountType        DiscountType?
  discountValue       Decimal?      @db.Decimal(12, 3)

  taxableBaseMinorUnits Int
  taxAmountMinorUnits   Int
  lineTotalMinorUnits   Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ============================================================================
// RECEIPTS
// ============================================================================

model Receipt {
  id          String        @id @default(cuid())
  workspaceId String
  invoiceId   String
  paymentId   String?       @unique
  number      String
  publicToken String        @unique
  status      ReceiptStatus @default(ISSUED)

  amountMinorUnits Int
  currency         String
  paymentMethod    PaymentMethod
  paidAt           DateTime

  /// Full immutable point-in-time snapshot: business info, customer info, line items, totals.
  snapshotJson Json

  voidedAt   DateTime?
  voidReason String?   @db.Text

  createdAt DateTime @default(now())

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice           Invoice           @relation(fields: [invoiceId], references: [id])
  payment           Payment?          @relation(fields: [paymentId], references: [id])
  items             ReceiptItem[]
  messageDeliveries MessageDelivery[]

  @@unique([workspaceId, number])
  @@index([workspaceId])
  @@index([invoiceId])
}

enum ReceiptStatus {
  ISSUED
  VOID
}

model ReceiptItem {
  id                  String  @id @default(cuid())
  receiptId           String
  description         String
  quantity            Decimal @db.Decimal(14, 4)
  unitPriceMinorUnits Int
  lineTotalMinorUnits Int

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id               String        @id @default(cuid())
  workspaceId      String
  amountMinorUnits Int
  currency         String
  method           PaymentMethod
  status           PaymentStatus @default(SUCCESSFUL)
  reference        String?
  paidAt           DateTime
  notes            String?       @db.Text

  paymentAttemptId String? @unique
  recordedById     String?

  createdAt DateTime @default(now())

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt?     @relation(fields: [paymentAttemptId], references: [id])
  allocations    PaymentAllocation[]
  refunds        Refund[]
  receipt        Receipt?

  @@index([workspaceId, status])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  PAYSTACK
  FLUTTERWAVE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

/// One payment can be allocated across multiple invoices (or split within one).
model PaymentAllocation {
  id               String   @id @default(cuid())
  paymentId        String
  invoiceId        String
  amountMinorUnits Int
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
}

/// A gateway checkout attempt (Paystack/Flutterwave) — may or may not result in a Payment.
model PaymentAttempt {
  id                String               @id @default(cuid())
  workspaceId       String
  invoiceId         String
  provider          PaymentProviderKey
  reference         String
  amountMinorUnits  Int
  currency          String
  status            PaymentAttemptStatus @default(INITIATED)
  authorizationUrl  String?
  rawInitResponse   Json?
  rawVerifyResponse Json?
  idempotencyKey    String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])
  payment   Payment?

  @@unique([provider, reference])
  @@index([workspaceId])
  @@index([invoiceId])
}

enum PaymentProviderKey {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCESSFUL
  FAILED
  ABANDONED
}

model Refund {
  id                String       @id @default(cuid())
  workspaceId       String
  paymentId         String
  amountMinorUnits  Int
  reason            String?      @db.Text
  status            RefundStatus @default(PENDING)
  providerReference String?
  createdAt         DateTime     @default(now())
  processedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment   Payment   @relation(fields: [paymentId], references: [id])

  @@index([workspaceId])
  @@index([paymentId])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model CreditNote {
  id               String           @id @default(cuid())
  workspaceId      String
  invoiceId        String
  number           String
  amountMinorUnits Int
  reason           String           @db.Text
  status           CreditNoteStatus @default(ISSUED)
  createdById      String?
  createdAt        DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@unique([workspaceId, number])
  @@index([invoiceId])
}

enum CreditNoteStatus {
  ISSUED
  VOID
}

// ============================================================================
// PAYMENT PROVIDER CONFIG (workspace-level credentials, encrypted at rest)
// ============================================================================

model PaymentProviderConfig {
  id                 String             @id @default(cuid())
  workspaceId        String
  provider           PaymentProviderKey
  isEnabled          Boolean            @default(false)
  /// AES-256-GCM ciphertext of the provider's secret key, encrypted with APP_ENCRYPTION_KEY. Never returned to the frontend.
  encryptedSecretKey String?
  publicKey          String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

// ============================================================================
// EXPENSES
// ============================================================================

model Expense {
  id                  String         @id @default(cuid())
  workspaceId         String
  vendor              String
  category            String
  amountMinorUnits    Int
  currency            String
  taxAmountMinorUnits Int            @default(0)
  incurredAt          DateTime
  paymentMethod       PaymentMethod?
  description         String?        @db.Text
  isRecurring         Boolean        @default(false)
  receiptFileAssetId  String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receiptFile FileAsset? @relation(fields: [receiptFileAssetId], references: [id])

  @@index([workspaceId, incurredAt])
  @@index([workspaceId, category])
}

// ============================================================================
// RECURRING INVOICES
// ============================================================================

model RecurringInvoice {
  id          String @id @default(cuid())
  workspaceId String
  customerId  String

  frequency          RecurringFrequency
  customIntervalDays Int?
  startDate          DateTime
  endDate            DateTime?
  nextRunAt          DateTime
  autoIssue          Boolean            @default(false)
  dueInDays          Int                @default(14)

  currency                 String
  taxMode                  TaxMode       @default(EXCLUSIVE)
  documentDiscountType     DiscountType?
  documentDiscountValue    Decimal?      @db.Decimal(12, 3)
  shippingMinorUnits       Int           @default(0)
  additionalFeesMinorUnits Int           @default(0)
  notes                    String?       @db.Text
  terms                    String?       @db.Text

  status         RecurringInvoiceStatus @default(ACTIVE)
  lastRunAt      DateTime?
  lastRunError   String?                @db.Text
  generatedCount Int                    @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer               @relation(fields: [customerId], references: [id])
  items     RecurringInvoiceItem[]

  @@index([workspaceId, status, nextRunAt])
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum RecurringInvoiceStatus {
  ACTIVE
  PAUSED
  ENDED
}

model RecurringInvoiceItem {
  id                  String        @id @default(cuid())
  recurringInvoiceId  String
  productId           String?
  position            Int           @default(0)
  description         String
  quantity            Decimal       @db.Decimal(14, 4)
  unitPriceMinorUnits Int
  taxRatePercent      Decimal       @default(0) @db.Decimal(6, 3)
  discountType        DiscountType?
  discountValue       Decimal?      @db.Decimal(12, 3)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recurringInvoiceId])
}

// ============================================================================
// REMINDERS / MESSAGE DELIVERY
// ============================================================================

model ReminderSchedule {
  id            String         @id @default(cuid())
  workspaceId   String
  invoiceId     String
  timing        ReminderTiming
  offsetDays    Int
  scheduledFor  DateTime
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  channel       MessageChannel @default(EMAIL)
  failureReason String?
  createdAt     DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, scheduledFor])
  @@index([invoiceId])
}

enum ReminderTiming {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED_OPT_OUT
}

model MessageDelivery {
  id                String         @id @default(cuid())
  workspaceId       String
  channel           MessageChannel
  status            MessageStatus  @default(QUEUED)
  toAddress         String
  subject           String?
  templateKey       String
  providerMessageId String?
  errorMessage      String?        @db.Text

  invoiceId String?
  quoteId   String?
  receiptId String?

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
  quote     Quote?    @relation(fields: [quoteId], references: [id])
  receipt   Receipt?  @relation(fields: [receiptId], references: [id])

  @@index([workspaceId, channel, status])
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  TELEGRAM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

// ============================================================================
// FILES
// ============================================================================

model FileAsset {
  id               String          @id @default(cuid())
  workspaceId      String
  kind             FileAssetKind
  storageProvider  StorageProvider
  objectKey        String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  uploadedById     String?
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfiles BusinessProfile[]
  invoices         Invoice[]
  expenses         Expense[]

  @@index([workspaceId, kind])
}

enum FileAssetKind {
  LOGO
  INVOICE_ATTACHMENT
  EXPENSE_RECEIPT
  GENERATED_PDF
  EXPORT
  OTHER
}

enum StorageProvider {
  LOCAL
  B2
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  workspaceId String?
  key         String
  name        String
  isCustom    Boolean  @default(false)
  configJson  Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// ============================================================================
// SUBSCRIPTIONS / BILLING / USAGE
// ============================================================================

model SubscriptionPlan {
  code                   String  @id
  name                   String
  description            String
  monthlyPriceMinorUnits Int
  yearlyPriceMinorUnits  Int
  currency               String
  limitsJson             Json
  isActive               Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                     String               @id @default(cuid())
  workspaceId            String               @unique
  planCode               String
  status                 SubscriptionStatus   @default(TRIALING)
  billingInterval        BillingInterval      @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean              @default(false)
  trialEndsAt            DateTime?
  provider               SubscriptionProvider @default(MANUAL)
  providerSubscriptionId String?
  promoCodeId            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planCode], references: [code])
  promoCode PromoCode?       @relation(fields: [promoCodeId], references: [id])

  @@index([status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionProvider {
  MANUAL
  PAYSTACK
  FLUTTERWAVE
}

model UsageCounter {
  id             String   @id @default(cuid())
  workspaceId    String
  /// YYYY-MM in the workspace's timezone.
  period         String
  invoicesIssued Int      @default(0)
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period])
}

model PromoCode {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(12, 3)
  appliesToPlan   String?
  maxRedemptions  Int?
  redemptionCount Int          @default(0)
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  subscriptions Subscription[]
}

// ============================================================================
// PLATFORM / ADMIN / OBSERVABILITY
// ============================================================================

model WebhookEvent {
  id              String             @id @default(cuid())
  workspaceId     String?
  provider        WebhookProvider
  externalEventId String?
  signatureValid  Boolean
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  errorMessage    String?            @db.Text
  processedAt     DateTime?
  createdAt       DateTime           @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@unique([provider, externalEventId])
  @@index([provider, status])
}

enum WebhookProvider {
  PAYSTACK
  FLUTTERWAVE
  META_WHATSAPP
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  hashedKey   String    @unique
  scopes      String[]
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  actor     User?      @relation(fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String?
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId, readAt])
}

/// Browser push subscription (Web Push API). One user can have several —
/// one per browser/device they've enabled notifications on.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  PAYMENT_RECEIVED
  INVOICE_OVERDUE
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  RECURRING_INVOICE_GENERATED
  PAYMENT_INTEGRATION_FAILURE
  TEAM_INVITATION
  SUBSCRIPTION_WARNING
  SECURITY_ALERT
  EXPORT_COMPLETED
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String                @id @default(cuid())
  workspaceId String?
  userId      String?
  subject     String
  message     String                @db.Text
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(NORMAL)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@index([status])
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model FeatureFlag {
  key               String   @id
  description       String?
  enabled           Boolean  @default(false)
  rolloutPercentage Int?
  metadata          Json?
  updatedAt         DateTime @updatedAt
}

model ApplicationSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}
