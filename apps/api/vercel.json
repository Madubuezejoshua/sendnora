{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run db:generate --workspace=@sendnaro/database && npm run build:api",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "../../{packages/database/generated,packages/database/dist,node_modules/pdfkit,node_modules/@react-pdf,node_modules/fontkit,node_modules/@fontsource/noto-sans}/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/outbox",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/v1/cron/maintenance",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/v1/cron/overdue-sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/cron/recurring-invoices",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/v1/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ]
}