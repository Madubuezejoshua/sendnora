# ==============================================================================
# Sendnaro: environment template
# ==============================================================================
# Copy to `.env` at the repo root (and apps/api/.env, apps/web/.env.local, packages/database/.env, or
# symlink them) for local development. In production set real environment variables on the hosts;
# never commit a populated .env file. See ENVIRONMENT.md for what each variable does and what stays
# disabled without it. Values below are empty or harmless placeholders.
# ==============================================================================

NODE_ENV=development

# --- URLs ----------------------------------------------------------------------
# One public origin serves the website and /api/v1 (the web app rewrites /api/v1/* to the API).
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL / Neon) ----------------------------------------------
# Local: `docker compose up -d`. Neon: DATABASE_URL = pooled (add pgbouncer=true), DIRECT_DATABASE_URL = unpooled
# (used by migrations). Add connect_timeout=30 on Neon: a sleeping compute can take seconds to wake.
DATABASE_URL="postgresql://sendnaro:sendnaro@localhost:5432/sendnaro?schema=public"
DIRECT_DATABASE_URL="postgresql://sendnaro:sendnaro@localhost:5432/sendnaro?schema=public"

# --- Platform secrets (each: openssl rand -base64 32) ----------------------------
# Auth.js session signing, and the signed token the web app mints for the API (console calls).
AUTH_SECRET=
API_TOKEN_SECRET=
# Encrypts stored provider credentials and webhook secrets (AES-256-GCM). Rotating it invalidates them.
APP_ENCRYPTION_KEY=
# Keys the one-time verification codes (HMAC). REQUIRED in production; dev/test derive one if unset.
OTP_HMAC_KEY=
# Bearer secret for /api/v1/cron/* (Vercel Cron sends it automatically when named CRON_SECRET).
CRON_SECRET=

# --- Platform admin seed -----------------------------------------------------------
# 12+ characters; do not use '#' (it starts a comment in .env files).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Delivery pipeline ----------------------------------------------------------------
# Run the outbox worker inside the API process (Docker, Railway, local). On Vercel leave false and rely on
# the cron drain plus the post-response drain. Or run it separately: `npm run worker --workspace=@sendnaro/api`.
WORKER_INLINE=false
# Dev/test only: allow SANDBOX webhook endpoints to target localhost. Rejected at boot in production.
ALLOW_LOCAL_WEBHOOK_TARGETS=false
# Retention (days). Sandbox data, OTP metadata after expiry, live delivery history, webhook events.
SANDBOX_RETENTION_DAYS=7
OTP_RETENTION_DAYS=1
DELIVERY_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=30

# --- Telegram (shared Sendnaro bot, optional) -------------------------------------------
# Create the bot with @BotFather. Register the webhook once (see docs/CHANNELS.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp -------------------------------------------------------------------------
# No platform-level WhatsApp variables: each business connects ITS OWN WhatsApp Business sender in the
# console (credentials are stored encrypted per business). META_WHATSAPP_API_VERSION is the Graph version.
META_WHATSAPP_API_VERSION=v20.0

# --- Account email (verification, password reset) -----------------------------------------
# EMAIL_PROVIDER=dev writes messages to apps/web/.dev-emails/ (development and tests only).
# Production must use resend; with anything else the web app refuses to send rather than log links.
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM="Sendnaro <noreply@sendnaro.com>"
EMAIL_REPLY_TO=

# --- Private file storage (Backblaze B2, S3-compatible) -------------------------------------
# STORAGE_PROVIDER=local writes to apps/api/.dev-storage/ (development only; production requires b2).
STORAGE_PROVIDER=local
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Sendnaro's own activation payments (Paystack) ------------------------------------------
# Used only when the owner turns on billing in the admin panel. sk_test_ keys never unlock production
# and never count as revenue; sk_live_ keys are live. Webhook URL: <origin>/api/v1/webhooks/sendnaro-activation
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Sign-in with Google (optional; inactive until both are set) ------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Legacy manual-invoicing endpoints (/api/legacy/v1) -----------------------------------
# Only needed if you still use the previous invoicing features and their payment gateways.
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
WHATSAPP_PROVIDER=click-to-chat
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Optional monitoring (do not send OTPs or PII to telemetry) -----------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
