# ==============================================================================
# InvoiceTap — root environment template
# ==============================================================================
# Copy this file to `.env` at the repo root for local development (both apps
# read from here via dotenv when run through `npm run dev`). For production,
# set these as real environment variables in Vercel (apps/web) and Railway
# (apps/api) — never commit a populated .env file.
#
# See ENVIRONMENT.md for the full variable reference table (required vs
# optional, where to obtain each secret, what stays disabled without it).
# ==============================================================================

NODE_ENV=development

# --- Core ---------------------------------------------------------------
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Database (Neon-compatible Postgres) --------------------------------
# Local dev: run `docker compose up -d` then use the connection string below.
DATABASE_URL="postgresql://invoicetap:invoicetap@localhost:5432/invoicetap?schema=public"
# Neon requires a separate *unpooled* connection string for migrations.
DIRECT_DATABASE_URL="postgresql://invoicetap:invoicetap@localhost:5432/invoicetap?schema=public"

# --- Auth / trust boundary (apps/web Auth.js <-> apps/api) --------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
API_TOKEN_SECRET=
# Encrypts workspace-stored provider secrets (Paystack/Flutterwave keys) at rest.
APP_ENCRYPTION_KEY=
# Protects the cron endpoints (recurring invoices, reminders, overdue sweep).
CRON_SECRET=

# --- Admin seed (packages/database/prisma/seed.ts) ----------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email ----------------------------------------------------------------
# EMAIL_PROVIDER=dev writes emails to apps/api/.dev-emails/*.html instead of sending.
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM="InvoiceTap <onboarding@invoicetap.app>"
EMAIL_REPLY_TO=

# --- Google OAuth (prepared, inactive until both are set) ----------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Storage (Backblaze B2, S3-compatible) --------------------------------
# STORAGE_PROVIDER=local writes to apps/api/.dev-storage/ instead.
STORAGE_PROVIDER=local
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Paystack --------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Flutterwave -------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Meta WhatsApp Cloud API (prepared, inactive without credentials) ------
# WHATSAPP_PROVIDER=click-to-chat needs no credentials and always works.
WHATSAPP_PROVIDER=click-to-chat
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v20.0

# --- Optional AI (Groq) — never required for core functionality -----------
AI_PROVIDER=none
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# --- Optional monitoring ----------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Optional browser push --------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@invoicetap.app"
