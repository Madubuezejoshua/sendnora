# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Sendnaro Security & Runtime Secrets (set in AI Studio Secrets for production)
# 32+ byte secret used for AES-256-GCM encryption of channel/webhook credentials at rest
APP_ENCRYPTION_KEY=

# 32+ byte secret used for HMAC-SHA256 OTP code generation (codes are never stored in plaintext)
OTP_HMAC_KEY=

# Optional platform admin password override (if unset, claim admin access once via first-run UI)
PLATFORM_ADMIN_PASSWORD=

# Optional platform admin email (defaults to workspace owner email)
PLATFORM_ADMIN_EMAIL=

# Meta WhatsApp Cloud API webhook verification & signing secrets (fail-closed when unset)
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Telegram Bot webhook secret token (fail-closed when unset)
TELEGRAM_WEBHOOK_SECRET=

# Activation gateway configuration (Paystack live secret key)
ACTIVATION_PAYSTACK_SECRET_KEY=

# Set to "true" only in local development to allow localhost webhook targets in SSRF filter
ALLOW_LOCAL_WEBHOOKS=false
